<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">
    <net.kdt.pojavlaunch.prefs.BackButtonPreference/>
    <PreferenceCategory android:title="@string/preference_category_experimental_settings"
        app2:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="dump_shaders"
            android:title="@string/preference_shader_dump_title"
            android:summary="@string/preference_shader_dump_description"
        app2:iconSpaceReserved="false"
            />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="bigCoreAffinity"
            android:title="@string/preference_force_big_core_title"
            android:summary="@string/preference_force_big_core_desc"
        app2:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="freedrenoSysmem"
            android:title="@string/preference_sysmem_title"
            android:summary="@string/preference_sysmem_summary"
        app2:iconSpaceReserved="false"
            />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="alsoftForceOpenSL"
            android:icon="@drawable/ic_px_dynamic"
            android:title="@string/preference_alsoft_opensl_title"
            android:summary="@string/preference_alsoft_opensl_summary"
            />
        <net.kdt.pojavlaunch.prefs.CustomSeekBarPreference
            android:key="pageOpacity"
            android:title="@string/preference_page_opacity_title"
            android:summary="@string/preference_page_opacity_summary"
            app2:showSeekBarValue="true"
            app2:selectable="false"
            app2:min="@integer/page_opacity_seekbar_min"
            android:max="@integer/page_opacity_seekbar_max"
            app2:seekBarIncrement="@integer/page_opacity_seekbar_increment"
        app2:iconSpaceReserved="false"
            />
        <Preference
            android:key="selectBackgroundImage"
            android:title="@string/preference_select_background_title"
            android:summary="@string/preference_select_background_summary"
        app2:iconSpaceReserved="false"
            />
        <Preference
            android:key="deleteBackgroundImage"
            android:title="@string/preference_delete_background_title"
            android:summary="@string/preference_delete_background_summary"
        app2:iconSpaceReserved="false"
            />
    </PreferenceCategory>
</PreferenceScreen>
