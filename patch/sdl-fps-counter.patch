diff --git a/src/video/SDL_egl.c b/src/video/SDL_egl.c
index a3ade14..04f6c85 100644
--- a/src/video/SDL_egl.c
+++ b/src/video/SDL_egl.c
@@ -1266,14 +1266,28 @@ bool SDL_EGL_GetSwapInterval(SDL_VideoDevice *_this, int *interval)
     return true;
 }
 
+#ifdef SDL_PLATFORM_ANDROID
+static SDL_AtomicInt egl_swap_count_android;
+#endif
+
 bool SDL_EGL_SwapBuffers(SDL_VideoDevice *_this, EGLSurface egl_surface)
 {
     if (!_this->egl_data->eglSwapBuffers(_this->egl_data->egl_display, egl_surface)) {
         return SDL_EGL_SetError("unable to show color buffer in an OS-native window", "eglSwapBuffers");
     }
+#ifdef SDL_PLATFORM_ANDROID
+    SDL_AddAtomicInt(&egl_swap_count_android, 1);
+#endif
     return true;
 }
 
+#ifdef SDL_PLATFORM_ANDROID
+int SDL_EGL_GetAndResetSwapCountAndroid(void)
+{
+    return SDL_SetAtomicInt(&egl_swap_count_android, 0);
+}
+#endif
+
 bool SDL_EGL_DestroyContext(SDL_VideoDevice *_this, SDL_GLContext context)
 {
     EGLContext egl_context = (EGLContext)context;
